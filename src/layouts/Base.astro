---
import '../styles/app.css';
import TopNav from '../components/layout/TopNav.astro';
import TimeTravelBar from '../components/layout/TimeTravelBar.astro';
import Footer from '../components/layout/Footer.astro';
import { getAllRacesBySeason, getLatestRaceWithData } from '../lib/queries';
import { SITE_URL } from '../lib/const';
import { resolvePageNavState } from '../lib/page-nav';
import type { PageContext } from '../lib/types';

interface Props {
  title: string;
  description: string;
  canonical: string;
  lang?: string;
  robots?: string;
  pageContext?: PageContext;
}

const { title, description, canonical, lang = 'en', robots, pageContext } = Astro.props;
const canonicalURL = new URL(canonical, SITE_URL).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonicalURL,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Race Rewind',
    url: SITE_URL,
  },
};

const [{ seasons, byseason }, latest] = await Promise.all([getAllRacesBySeason(), getLatestRaceWithData()]);

const { currentSeason, currentRaceSlug, currentChainSlug, compareSlug, section } =
  resolvePageNavState(pageContext, latest);

type LastRaceEntry =
  | { kind: 'preseason' | 'postseason'; season: number }
  | { kind: 'race'; season: number; raceSlug: string; name: string; flag: null };

function savedBoundaryEntry(
  season: number,
  chainSlug?: string,
): LastRaceEntry | null {
  if (chainSlug !== 'preseason' && chainSlug !== 'postseason') return null;
  return { kind: chainSlug, season };
}

function savedRaceEntry(
  season: number,
  raceSlug: string,
  raceName: string | null,
): LastRaceEntry | null {
  if (raceSlug === 'preseason' || raceSlug === 'postseason') {
    return { kind: raceSlug, season };
  }
  if (!raceName) return null;
  return { kind: 'race', season, raceSlug, name: raceName, flag: null };
}

function resolveLastRaceEntry(context: PageContext | undefined): LastRaceEntry | null {
  if (!context) return null;

  switch (context.kind) {
    case 'preseason':
    case 'postseason':
      return { kind: context.kind, season: context.season };
    case 'race':
    case 'driver-race':
    case 'team-race':
    case 'compare-race':
      return savedRaceEntry(context.season, context.raceSlug, context.raceName);
    case 'stats':
      return savedRaceEntry(context.season, context.chainSlug, context.raceName);
    case 'season':
      return savedBoundaryEntry(context.season, context.chainSlug);
    case 'driver-preseason':
    case 'team-preseason':
      return { kind: 'preseason', season: context.season };
    case 'driver-postseason':
    case 'team-postseason':
      return { kind: 'postseason', season: context.season };
  }
}

const lastRaceEntry = resolveLastRaceEntry(pageContext);
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script
      defer
      src="https://umami.philippkuhnhardt.de/script.js"
      data-website-id="e45eebe4-0a64-4bc7-a41d-3aa69037600d"></script>

    <!-- Anti-flash: read theme from localStorage before first paint -->
    <script is:inline>
      try {
        const t =
          localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', t);
        // eslint-disable-next-line no-empty
      } catch {}
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {
      lastRaceEntry && (
        <script is:inline define:vars={{ lastRaceEntry }}>
          try {
            localStorage.setItem('lastRace', JSON.stringify(lastRaceEntry));
          } catch {
            // localStorage unavailable
          }
        </script>
      )
    }
  </head>
  <body class="min-h-screen bg-bg font-sans text-fg antialiased">
    <div class="flex min-h-screen flex-col">
      <div class="sticky top-0 z-40">
        <TopNav
          {seasons}
          {byseason}
          {currentSeason}
          {currentRaceSlug}
          {currentChainSlug}
          {compareSlug}
          {section}
          allowSavedPitOverride={!pageContext}
        />

        {pageContext && <TimeTravelBar {pageContext} />}
      </div>

      <main class="mx-auto w-full max-w-[var(--container-narrow)] flex-1 px-4 py-8 sm:px-6">
        <slot />
      </main>

      <Footer />
    </div>
  </body>
</html>
