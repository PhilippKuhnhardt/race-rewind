---
import Base from './Base.astro';
import RaceHeroCard from '../components/race/RaceHeroCard.astro';
import RaceSubNav from '../components/race/RaceSubNav.astro';
import type { PageContext } from '../lib/types';
import { raceFlag } from '../lib/ui/emojify';

interface Props {
  race: {
    name: string;
    season: number;
    round: number;
    date: string;
    circuit_name: string;
    circuit_locality: string | null;
    circuit_country: string | null;
    has_sprint: number | null;
  };
  raceCount: number;
  raceSlug: string;
  hasGrid: boolean;
  sessionOrder: string[];
  pageContext: PageContext;
  title: string;
  description: string;
  canonical: string;
  activeId: 'overview' | 'qualifying' | 'sprint-qualifying' | 'sprint' | 'grid' | 'race' | 'standings';
  overviewOnly?: boolean;
  hasStandings?: boolean;
}

const {
  race,
  raceCount,
  raceSlug,
  hasGrid,
  sessionOrder,
  pageContext,
  title,
  description,
  canonical,
  activeId,
  overviewOnly = false,
  hasStandings = true,
} = Astro.props;
const circuitFlag = race.circuit_country ? (raceFlag(race.circuit_country) ?? null) : null;
---

<Base {title} {description} {canonical} {pageContext}>
  <RaceHeroCard
    name={race.name}
    season={race.season}
    round={race.round}
    {raceCount}
    date={race.date}
    circuitName={race.circuit_name}
    circuitLocality={race.circuit_locality}
    circuitCountry={race.circuit_country}
  />

  <RaceSubNav
    season={race.season}
    {raceSlug}
    {sessionOrder}
    {hasGrid}
    {overviewOnly}
    {hasStandings}
    {activeId}
  />

  <slot />
</Base>

<script is:inline define:vars={{ season: race.season, raceSlug, raceName: race.name, circuitFlag }}>
  try {
    localStorage.setItem('lastRace', JSON.stringify({ kind: 'race', season, raceSlug, name: raceName, flag: circuitFlag }));
  } catch { /* localStorage unavailable */ }
</script>
