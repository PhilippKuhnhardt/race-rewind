---
import RaceHeroCard from '../../../../components/race/RaceHeroCard.astro';
import TeamStandingsTable from '../../../../components/standings/TeamStandingsTable.astro';
import Base from '../../../../layouts/Base.astro';
import { raceLink } from '../../../../lib/format';
import { pitForRace } from '../../../../lib/point-in-time';
import { getAllRaces, getTeamStandings, getTeamStandingsBeforeRace } from '../../../../lib/queries';
import { getRacePageBase } from '../../../../lib/race-page';
import { raceSessionSeo } from '../../../../lib/seo';

export async function getStaticPaths() {
  return (await getAllRaces()).map((r) => ({
    params: { season: String(r.season), race: r.race_slug },
  }));
}

const { season, race: raceSlug } = Astro.params;
const base = await getRacePageBase(season, raceSlug);
if (!base) throw new Error(`Race not found: ${season}-${raceSlug}`);
const { race, raceCount, pageContext, availability } = base;
const pit = pitForRace(race, raceSlug!);

const preRaceTeamChamp = availability.standingsAsOfRaceNumber != null
  ? await getTeamStandings(availability.standingsAsOfRaceNumber)
  : await getTeamStandingsBeforeRace(race.race_number);
const standingsHint = availability.status === 'future' && availability.latestCompletedRound != null
  ? `Season in progress — standings as of round ${availability.latestCompletedRound} / ${raceCount} (${availability.latestCompletedName}).`
  : null;

const { title, description } = raceSessionSeo(race, 'Teams');
---

<Base
  title={title}
  description={description}
  canonical={`${raceLink(season, raceSlug)}teams/`}
  {pageContext}
>
  <RaceHeroCard
    name={race.name}
    season={race.season}
    round={race.round}
    raceCount={raceCount}
    date={race.date}
    circuitName={race.circuit_name}
    circuitLocality={race.circuit_locality}
    circuitCountry={race.circuit_country}
  />

  {standingsHint && (
    <div class="mb-6 rounded-lg border border-border bg-bg-alt px-4 py-3 text-sm text-fg-muted">
      {standingsHint}
    </div>
  )}

  <TeamStandingsTable
    title="Constructors' Championship"
    rows={preRaceTeamChamp}
    {pit}
    emptyNote="First race of the season — championship not yet started."
  />
</Base>
