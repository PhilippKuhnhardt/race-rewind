---
import PreRaceLeaders from '../../../../components/race/PreRaceLeaders.astro';
import RaceNewsCard from '../../../../components/race/RaceNewsCard.astro';
import RecentFormStrip from '../../../../components/season/RecentFormStrip.astro';
import DriverStandingsTable from '../../../../components/standings/DriverStandingsTable.astro';
import TeamStandingsTable from '../../../../components/standings/TeamStandingsTable.astro';
import RaceSessionLayout from '../../../../layouts/RaceSessionLayout.astro';
import { raceLink } from '../../../../lib/format';
import { pitForRace } from '../../../../lib/point-in-time';
import {
  getAllRaces,
  getDriverStandings,
  getDriverStandingsBeforeRace,
  getRecentFormRows,
  getTeamStandings,
  getTeamStandingsBeforeRace,
} from '../../../../lib/queries';
import { getRaceNews } from '../../../../lib/race-news';
import { getRacePageBase } from '../../../../lib/race-page';
import { raceOverviewSeo } from '../../../../lib/seo';

export async function getStaticPaths() {
  return (await getAllRaces()).map((r) => ({
    params: { season: String(r.season), race: r.race_slug },
  }));
}

const { season, race: raceSlug } = Astro.params;
const base = await getRacePageBase(season, raceSlug);
if (!base) throw new Error(`Race not found: ${season}-${raceSlug}`);
const { race, raceCount, pageContext, hasGrid, sessionOrder, availability } = base;
const pit = pitForRace(race, raceSlug!);
const standingsAsOfRaceNumber = availability.standingsAsOfRaceNumber;

const [preRaceDriverChamp, preRaceTeamChamp, recentForm] = await Promise.all([
  standingsAsOfRaceNumber != null
    ? getDriverStandings(standingsAsOfRaceNumber)
    : getDriverStandingsBeforeRace(race.race_number),
  standingsAsOfRaceNumber != null
    ? getTeamStandings(standingsAsOfRaceNumber)
    : getTeamStandingsBeforeRace(race.race_number),
  getRecentFormRows(race.season, availability.recentFormAsOfRaceNumber, 5),
]);

const driverLeader = preRaceDriverChamp[0]
  ? {
      full_name: preRaceDriverChamp[0].full_name,
      driver_slug: preRaceDriverChamp[0].driver_slug,
      points: preRaceDriverChamp[0].points,
      gap:
        preRaceDriverChamp[0].points -
        (preRaceDriverChamp[1]?.points ?? preRaceDriverChamp[0].points),
    }
  : null;

const teamLeader = preRaceTeamChamp[0]
  ? {
      team_name: preRaceTeamChamp[0].team_name,
      team_slug: preRaceTeamChamp[0].team_slug,
      points: preRaceTeamChamp[0].points,
      gap: preRaceTeamChamp[0].points - (preRaceTeamChamp[1]?.points ?? preRaceTeamChamp[0].points),
    }
  : null;

const newsEntry = await getRaceNews(`${season}-${raceSlug}`, 'preview');

const { title, description } = raceOverviewSeo(race);
const standingsHint = availability.status === 'future' && availability.latestCompletedRound != null
  ? `Season in progress — standings as of round ${availability.latestCompletedRound} / ${raceCount} (${availability.latestCompletedName}).`
  : null;
---

<RaceSessionLayout
  {race}
  {raceCount}
  {raceSlug}
  {hasGrid}
  {sessionOrder}
  {pageContext}
  {title}
  {description}
  canonical={raceLink(season, raceSlug)}
  activeId="overview"
  overviewOnly={availability.overviewOnly}
  hasStandings={availability.hasRaceResults}
>
  <div class="space-y-8">
    <PreRaceLeaders {driverLeader} {teamLeader} season={race.season} {raceSlug} />
    {newsEntry && <RaceNewsCard entry={newsEntry} />}

    <RecentFormStrip rows={recentForm} {pit} />

    {standingsHint && (
      <div class="rounded-lg border border-border bg-bg-alt px-4 py-3 text-sm text-fg-muted">
        {standingsHint}
      </div>
    )}

    <!-- Pre-race standings truncated — link to full Drivers/Teams tabs -->
    <DriverStandingsTable
      title="Drivers' Championship"
      rows={preRaceDriverChamp.slice(0, 10)}
      {pit}
      emptyNote="First race of the season — championship not yet started."
      viewAllHref={`/seasons/${race.season}/${raceSlug}/drivers/`}
    />

    <TeamStandingsTable
      title="Constructors' Championship"
      rows={preRaceTeamChamp.slice(0, 5)}
      {pit}
      viewAllHref={`/seasons/${race.season}/${raceSlug}/teams/`}
      emptyNote="First race of the season — championship not yet started."
    />
  </div>
</RaceSessionLayout>
