---
import { getLatestRaceWithData } from '../../lib/queries';

const { season, slug } = await getLatestRaceWithData();
const target = `/compare/${season}/${slug.slice(String(season).length + 1)}/`;
---

<meta http-equiv="refresh" content={`0; url=${target}`} />
<script is:inline define:vars={{ target }}>window.location.href = target;</script>
